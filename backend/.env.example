# Port the Node.js API listens on
PORT=8000

# Secret used to sign JWT auth tokens — change this in production
JWT_SECRET=intranet-dev-secret

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=intranet_app
DB_PASSWORD=intranet_pass
DB_NAME=intranet

# Path to your raw .sql dump file (used by `npm run db:import`)
# Defaults to backend/db/UCFE_Template_mysql.sql if left unset
SQL_IMPORT_FILE=./db/UCFE_Template_mysql.sql

# Seeded demo employee login (used by `npm run db:seed`)
INTRANET_SERVICE_NO=6609
INTRANET_PASSWORD=6609
